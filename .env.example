# Copy to .env and change values. Never commit .env.

TASKDESK_DB_PATH=./data/taskdesk.db
TASKDESK_AUDIT_PATH=./logs/audit.jsonl
TASKDESK_TIMEZONE=Asia/Karachi

# stdio (default) or http (Phase 9 stretch)
TASKDESK_TRANSPORT=stdio
TASKDESK_HTTP_PORT=3333
TASKDESK_HTTP_TOKEN=replace-with-a-long-random-value

# Only for the optional Notion store (Phase 9)
NOTION_TOKEN=
NOTION_DATABASE_ID=
